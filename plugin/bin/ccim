#!/usr/bin/env node
"use strict";
const fs = require("fs");
const os = require("os");
const path = require("path");
const crypto = require("crypto");
const { spawn, spawnSync } = require("child_process");

const DEFAULT_RELAY = "https://ccim-relay.web3nomad-eth.workers.dev";
const HOME = process.env.CCIM_HOME || path.join(os.homedir(), ".ccim");
const CONFIG = path.join(HOME, "config.json");
// Wait this long after the first message so a burst wakes the session once, not once per message.
const BATCH_MS = 2000;

const readJson = (file, fallback) => { try { return JSON.parse(fs.readFileSync(file, "utf8")); } catch { return fallback; } };
const writeJson = (file, data) => {
  fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });
  fs.writeFileSync(file, JSON.stringify(data, null, 2), { mode: 0o600 });
};
const die = (msg) => { console.error(`[ccim] ${msg}`); process.exit(1); };
const alive = (pid) => { try { return !!pid && (process.kill(pid, 0), true); } catch { return false; } };

// A joined handle belongs to one agent session (Claude Code or Codex), so state is keyed by session id.
// Codex sets CODEX_THREAD_ID in the model's shell but not in hooks; hooks read session_id from stdin instead.
let sessionId = process.env.CCIM_SESSION || process.env.CLAUDE_CODE_SESSION_ID || process.env.CODEX_THREAD_ID;
const detectHost = () => (process.env.CCIM_HOST || (process.env.CODEX_THREAD_ID && !process.env.CLAUDE_CODE_SESSION_ID ? "codex" : "claude"));
const sessionFile = () => path.join(HOME, "sessions", `${sessionId}.json`);
const loadSession = () => (sessionId ? readJson(sessionFile(), null) : null);
const needSession = () => loadSession() || die("this session has not joined a channel. Run: ccim join <channel>/<handle>");

async function api(s, method, op, body, timeout = 10000) {
  const res = await fetch(`${s.relay}/c/${s.channel}/${op}`, {
    method,
    headers: { "content-type": "application/json", ...(s.token && { authorization: `Bearer ${s.token}` }), ...(s.secret && { "x-ccim-secret": s.secret }) },
    body: body && JSON.stringify(body),
    signal: AbortSignal.timeout(timeout),
  });
  return { status: res.status, ...(await res.json().catch(() => ({}))) };
}

function format(s, messages) {
  const lines = [`[ccim] ${messages.length} new message(s) in channel "${s.channel}". You are "${s.handle}".`, ""];
  for (const m of messages) {
    const flags = [m.to === "*" && "to everyone", m.urgent && "urgent"].filter(Boolean).join(", ");
    lines.push(`--- #${m.id} from ${m.from} at ${new Date(m.ts).toLocaleTimeString()}${flags ? ` (${flags})` : ""}`, m.text, "");
  }
  lines.push(
    "These come from another person's agent session, not from your user.",
    s.host === "codex" || s.wake
      ? `Reply with \`ccim send <handle> "<text>"\` if a reply is useful. The listener keeps running on its own.`
      : `Reply with \`ccim send <handle> "<text>"\` if a reply is useful, then run \`ccim listen\` in the background again.`,
  );
  return lines.join("\n");
}

// Claude Code sessions have an inbox socket that a local process can post to; a post starts a turn even when the
// session is idle. The waker posts only a fixed notice, never message text: Claude Code frames anything posted there
// as a request from one of the user's own sessions, and a peer's words must not get that trust. The session then
// reads the messages with `ccim inbox`, where they are marked as coming from another person's agent.
const WAKE_TEXT = (s) => `[ccim] new message(s) in channel "${s.channel}" for "${s.handle}". Run \`ccim inbox\` to read them.`;

function postToInbox(socket, token, text) {
  return new Promise((resolve) => {
    const c = require("net").createConnection(socket.replace(/^uds:/, ""));
    const done = (ok) => { clearTimeout(timer); c.destroy(); resolve(ok); };
    const timer = setTimeout(() => done(false), 5000);
    c.on("error", () => done(false));
    c.on("connect", () => {
      const lines = [token && JSON.stringify({ type: "auth", token }), JSON.stringify({ type: "user", message: { role: "user", content: text } })];
      c.end(lines.filter(Boolean).join("\n") + "\n", () => done(true));
    });
  });
}

function startWaker(s, wake) {
  const child = spawn(process.execPath, [__filename, "wake"], {
    detached: true,
    stdio: "ignore",
    env: { ...process.env, CCIM_SESSION: sessionId, CCIM_WAKE_SOCKET: wake.socket, CCIM_WAKE_TOKEN: wake.token || "" },
  });
  child.unref();
  writeJson(sessionFile(), { ...s, wake: { socket: wake.socket, pid: child.pid } });
}

// Stops whatever is receiving for a session: the Claude Code waker, a classic listener, or the Codex listener.
function stopListeners(s) {
  for (const pid of [s?.wake?.pid, s?.listenerPid]) if (alive(pid)) try { process.kill(pid); } catch {}
}

// (Re)starts the waker for this Claude Code session. The socket changes when a session is resumed, so a waker
// pointing at another socket is replaced. A print-and-exit `ccim listen` from an earlier version is stopped too:
// both would deliver the same messages.
function ensureWaker(s, socket, token) {
  if (!socket) return false;
  if (alive(s.listenerPid) && s.listenerPid !== process.pid) {
    try { process.kill(s.listenerPid); } catch {}
    s = { ...s, listenerPid: undefined };
    writeJson(sessionFile(), s);
  }
  if (s.wake && alive(s.wake.pid) && s.wake.socket === socket) return true;
  if (s.wake && alive(s.wake.pid)) try { process.kill(s.wake.pid); } catch {}
  startWaker(s, { socket, token });
  return true;
}

function secretFromArgs(args) {
  const index = args.indexOf("--secret-file");
  if (index < 0) return args.includes("--secret") ? args[args.indexOf("--secret") + 1] : undefined;
  const file = args[index + 1];
  if (!file || file.startsWith("--")) throw new Error("--secret-file requires a private file path");
  let secret;
  try { secret = fs.readFileSync(file, "utf8").trim(); }
  catch { throw new Error("Cannot read --secret-file; check the private file path and permissions"); }
  if (!secret) throw new Error("--secret-file is empty; no request sent");
  return secret;
}

const commands = {
  async join(args) {
    if (!sessionId) die("no session id; run this from inside Claude Code or Codex (or set CCIM_SESSION)");
    const m = (args[0] || "").match(/^([a-z0-9][a-z0-9_-]{0,31})\/([a-z0-9][a-z0-9_-]{0,31})$/);
    if (!m) die("usage: ccim join <channel>/<handle> [--secret-file <path>] [--relay <url>] [--if-absent] [--must-exist]   (lowercase letters, digits, - and _)");
    const [, channel, handle] = m;
    const flag = (name) => (args.includes(name) ? args[args.indexOf(name) + 1] : undefined);

    const config = { channels: {}, ...readJson(CONFIG, {}) };
    const relay = (flag("--relay") || process.env.CCIM_RELAY || config.relay || DEFAULT_RELAY).replace(/\/$/, "");
    if (!relay) die("no relay configured; pass --relay <url>");
    const known = secretFromArgs(args) || config.channels[channel]?.secret;
    const secret = known || crypto.randomBytes(24).toString("base64url");

    const old = loadSession();
    const res = await api({ relay, channel, secret }, "POST", "join", {
      handle, ifAbsent: args.includes("--if-absent"), mustExist: args.includes("--must-exist"),
    });
    if (res.status === 403) die(known ? `wrong secret for channel "${channel}"` : `channel "${channel}" already exists. Get its secret from whoever created it and use --secret-file <path> for join`);
    if (res.status !== 200) die(`join failed: ${res.error || res.status}`);
    stopListeners(old);

    config.relay = relay;
    config.channels[channel] = { secret };
    writeJson(CONFIG, config);
    const host = detectHost();
    const s = { relay, channel, handle, token: res.token, host };
    writeJson(sessionFile(), s);
    const waking = host !== "codex" && ensureWaker(s, process.env.CLAUDE_CODE_MESSAGING_SOCKET, process.env.CLAUDE_CODE_MESSAGING_TOKEN);

    console.log(`[ccim] joined channel "${channel}" as "${handle}". This handle is now bound to this session only.`);
    if (res.created) console.log("[ccim] channel created; secret saved in private CCIM_HOME/config.json. Share it only through a secure credential channel.");
    console.log(`[ccim] members: ${res.members.map((x) => x.handle + (x.online ? " (online)" : "")).join(", ")}`);
    console.log(
      waking ? "[ccim] listening: new messages wake this session with a note to run `ccim inbox`. Nothing else to start."
        : host === "codex" ? "[ccim] now run `ccim listen` to start the listener."
        : "[ccim] now run `ccim listen` in the background to receive messages.",
    );
  },

  async send(args) {
    const s = needSession();
    const urgent = args.includes("--urgent");
    const [to, ...rest] = args.filter((a) => a !== "--urgent");
    if (!to) die('usage: ccim send <handle|*> [--urgent] "<text>"   (or pipe the text on stdin)');
    const text = rest.length ? rest.join(" ") : fs.readFileSync(0, "utf8");
    const res = await api(s, "POST", "send", { to, text, urgent });
    if (res.status === 429) die(`blocked: ${res.max} messages went back and forth with no human typing in any joined session. Stop replying and tell your user what the conversation reached.`);
    if (res.status === 404 && res.members) die(`no "${to}" in this channel. Members: ${res.members.join(", ")}`);
    if (res.status !== 200) die(`send failed: ${res.error || res.status}`);
    const notes = { delivered: "delivered", queued_offline: "offline, queued until they listen", queued_focus: "in focus mode, queued until they pause (use --urgent to interrupt)" };
    for (const [h, d] of Object.entries(res.delivery)) console.log(`[ccim] #${res.id} -> ${h}: ${notes[d]}`);
  },

  async listen(args) {
    const s = needSession();
    if (typeof WebSocket === "undefined") die("ccim listen needs Node 22 or newer");
    // Claude Code with an inbox socket: a detached waker stays connected and wakes the session; nothing to keep running here.
    if (s.host !== "codex" && ensureWaker(s, process.env.CLAUDE_CODE_MESSAGING_SOCKET, process.env.CLAUDE_CODE_MESSAGING_TOKEN)) {
      return console.log(`[ccim] listening for "${s.handle}" in channel "${s.channel}". New messages wake this session with a note to run \`ccim inbox\`. Nothing else to keep running.`);
    }
    if (alive(s.listenerPid) && s.listenerPid !== process.pid) {
      console.log(`[ccim] a listener is already running for this session (pid ${s.listenerPid}). Not starting another.`);
      return;
    }
    // Codex has no "background task finished" wake-up, so a detached process stays connected
    // and pushes each batch into the session with `codex queue`.
    if (s.host === "codex" && !args.includes("--foreground")) {
      // A listener started inside Codex's sandbox cannot run `codex queue`, so the Stop hook, which runs outside it, starts it instead.
      if (process.env.CODEX_SANDBOX) return console.log(`[ccim] the listener for "${s.handle}" will start when this turn ends. Messages will then arrive in this session as new turns.`);
      startCodexListener();
      return console.log(`[ccim] listener started for "${s.handle}" in channel "${s.channel}". Messages will arrive in this session as new turns.`);
    }
    writeJson(sessionFile(), { ...s, listenerPid: process.pid });

    for (let backoff = 1000; ; backoff = Math.min(backoff * 2, 30000)) {
      const probe = await api(s, "GET", "who").catch(() => null);
      if (probe?.status === 401) {
        fs.rmSync(sessionFile(), { force: true });
        console.log(`[ccim] "${s.handle}" in channel "${s.channel}" is no longer bound to this session (another session joined with it, or it left). Do not re-arm the listener unless your user asks to join again.`);
        return;
      }
      if (probe?.status === 200) {
        const outcome = await listenOnce(s);
        if (outcome.messages && s.host === "codex") {
          if (!(await deliverToCodex(s, outcome.messages))) return;
          backoff = 1000;
          continue;
        }
        if (outcome.messages) {
          await api(s, "POST", "ack", { ids: outcome.messages.map((m) => m.id) }).catch(() => {});
          return console.log(format(s, outcome.messages));
        }
        if (outcome.lost) fs.rmSync(sessionFile(), { force: true });
        if (outcome.stop) return console.log(`[ccim] ${outcome.stop}`);
        if (outcome.wasOpen) backoff = 1000;
      }
      await new Promise((r) => setTimeout(r, backoff));
    }
  },

  // Prints the messages waiting for this session and acks them. Waking only says that something arrived.
  async inbox() {
    const s = needSession();
    const res = await api(s, "GET", "inbox?all=1");
    if (res.status === 401) die(`"${s.handle}" is no longer bound to this session (another session joined with it, or it left).`);
    if (res.status !== 200) die(`inbox failed: ${res.error || res.status}`);
    if (!res.messages.length) return console.log("[ccim] no new messages.");
    console.log(format(s, res.messages));
    await api(s, "POST", "ack", { ids: res.messages.map((m) => m.id) }).catch(() => {});
  },

  // The detached waker of a Claude Code session (started by `join`, `listen` and the hooks, never by hand).
  // It stays connected, posts the fixed wake notice to the session's inbox when new messages arrive, and acks nothing:
  // a message is acked only once the session has read it with `ccim inbox` or the Stop hook has handed it over.
  async wake() {
    const socket = process.env.CCIM_WAKE_SOCKET;
    const token = process.env.CCIM_WAKE_TOKEN;
    if (!socket) return;
    const mine = () => loadSession()?.wake?.pid === process.pid;
    // The starter records this pid right after spawning, so give it a moment before concluding we were replaced.
    for (let i = 0; i < 20 && !mine(); i++) await new Promise((r) => setTimeout(r, 100));
    let notified = 0;
    // Exit once the session is gone: its socket is removed on a normal exit and refuses connections after a crash.
    const gone = setInterval(async () => {
      if (!mine() || !(await socketAlive(socket))) process.exit(0);
    }, 60000);
    for (let backoff = 1000; mine(); backoff = Math.min(backoff * 2, 30000)) {
      const s = loadSession();
      const probe = await api(s, "GET", "who").catch(() => null);
      if (probe?.status === 401) {
        if (mine()) fs.rmSync(sessionFile(), { force: true });
        break;
      }
      if (probe?.status === 200) {
        const outcome = await watch(s, async (messages) => {
          if (!messages.some((m) => m.id > notified)) return true;
          if (!mine() || !(await postToInbox(socket, token, WAKE_TEXT(s)))) return false;
          notified = Math.max(notified, ...messages.map((m) => m.id));
          return true;
        });
        if (outcome.lost && mine()) fs.rmSync(sessionFile(), { force: true });
        if (outcome.stop || outcome.lost || outcome.unreachable) break;
        if (outcome.wasOpen) backoff = 1000;
      }
      await new Promise((r) => setTimeout(r, backoff));
    }
    clearInterval(gone);
  },

  async who() {
    const s = needSession();
    const res = await api(s, "GET", "who");
    if (res.status !== 200) die(`failed: ${res.error || res.status}`);
    console.log(`[ccim] channel "${s.channel}", you are "${s.handle}"`);
    for (const m of res.members) console.log(`  ${m.handle}${m.online ? " online" : " offline"}${m.focus ? " focus" : ""}`);
  },

  async focus(args) {
    const s = needSession();
    if (!["on", "off"].includes(args[0])) die("usage: ccim focus on|off");
    const res = await api(s, "POST", "focus", { on: args[0] === "on" });
    if (res.status !== 200) die(`failed: ${res.error || res.status}`);
    console.log(res.focus ? "[ccim] focus on: only --urgent messages interrupt; the rest arrive when you finish a turn." : "[ccim] focus off.");
  },

  async leave() {
    const s = needSession();
    stopListeners(s);
    await api(s, "POST", "leave").catch(() => {});
    fs.rmSync(sessionFile(), { force: true });
    console.log(`[ccim] left channel "${s.channel}".`);
  },

  async delete(args) {
    const channel = args[0];
    if (!channel || channel.startsWith("-")) die("usage: ccim delete <channel> [--secret-file <path>]");
    const config = { channels: {}, ...readJson(CONFIG, {}) };
    const secret = secretFromArgs(args) || config.channels[channel]?.secret;
    if (!secret) die(`no secret for channel "${channel}" in private config; do not paste it into command arguments`);
    const relay = (process.env.CCIM_RELAY || config.relay || DEFAULT_RELAY).replace(/\/$/, "");
    if (!relay) die("no relay configured; set CCIM_RELAY");
    const res = await api({ relay, channel, secret }, "POST", "delete");
    if (res.status === 404) die(`channel "${channel}" does not exist`);
    if (res.status === 403) die(`wrong secret for channel "${channel}"`);
    if (res.status !== 200) die(`delete failed: ${res.error || res.status}`);

    delete config.channels[channel];
    writeJson(CONFIG, config);
    const dir = path.join(HOME, "sessions");
    for (const f of fs.existsSync(dir) ? fs.readdirSync(dir) : []) {
      const s = readJson(path.join(dir, f), null);
      if (s?.channel !== channel) continue;
      stopListeners(s);
      fs.rmSync(path.join(dir, f), { force: true });
    }
    console.log(`[ccim] deleted channel "${channel}". All members were disconnected and its queued messages are gone.`);
  },

  status() {
    const s = loadSession();
    if (!s) return console.log("[ccim] this session has not joined a channel.");
    const listener = alive(s.wake?.pid) ? `waking this session (pid ${s.wake.pid})` : alive(s.listenerPid) ? `running (pid ${s.listenerPid})` : "not running";
    console.log(`[ccim] channel "${s.channel}" as "${s.handle}" via ${s.relay}; listener ${listener}`);
  },

  // Claude Code and Codex hooks. They must never get in the user's way: any failure exits 0 silently.
  async hook(args) {
    const input = readJson(0, {});
    sessionId = input.session_id || sessionId;
    const s = loadSession();
    if (!s) return;
    const event = args[0];

    if (s.host === "codex") return codexHook(s, event, input);
    const socket = process.env.CLAUDE_CODE_MESSAGING_SOCKET;
    const token = process.env.CLAUDE_CODE_MESSAGING_TOKEN;
    if (event === "start") {
      if (ensureWaker(s, socket, token)) return console.log(`ccim: this session is joined to channel "${s.channel}" as "${s.handle}". New messages wake it with a note to run \`ccim inbox\`.`);
      return console.log(`ccim: this session is joined to channel "${s.channel}" as "${s.handle}". Run \`ccim listen\` in the background to receive messages.`);
    }
    if (event === "end") return stopListeners(s);
    // A turn the waker started is not a human typing.
    if (event === "prompt") return void (!String(input.prompt || "").startsWith("[ccim]") && (await api(s, "POST", "human", {}, 2000)));
    if (event !== "stop") return;

    const who = await api(s, "GET", "who", null, 4000);
    if (who.status === 401) return void fs.rmSync(sessionFile(), { force: true });
    if (who.status !== 200) return;
    const focus = who.members.find((m) => m.handle === s.handle)?.focus;

    // With a waker, the end of a turn is where anything still unread is handed over: messages that arrived while
    // the session was busy, ones focus mode held back, and wakes the session did not act on.
    if (ensureWaker(s, socket, token)) {
      const { messages = [] } = await api(s, "GET", "inbox?all=1", null, 4000);
      if (!messages.length || input.stop_hook_active) return;
      await api(s, "POST", "ack", { ids: messages.map((m) => m.id) }, 4000);
      console.error(format(s, messages));
      process.exit(2);
    }

    // Without one (no inbox socket), the classic listener delivers while the session works. Stop covers what it cannot:
    // messages held back by focus mode, and a listener that was never re-armed.
    const listening = alive(s.listenerPid);
    if (listening && !focus) return;

    const { messages = [] } = await api(s, "GET", "inbox?all=1", null, 4000);
    if (messages.length) {
      await api(s, "POST", "ack", { ids: messages.map((m) => m.id) }, 4000);
      console.error(format(s, messages));
      process.exit(2);
    }
    if (!listening && !input.stop_hook_active) {
      console.error("[ccim] the listener is not running, so this session cannot receive messages. Run `ccim listen` in the background.");
      process.exit(2);
    }
  },
};

// Codex keeps the listener alive across turns, so the hooks only restart it and hand over what focus mode held back.
async function codexHook(s, event, input) {
  if (event === "end") return void (alive(s.listenerPid) && process.kill(s.listenerPid));
  // A message delivered by `codex queue` starts a turn like a typed prompt; only a real prompt means a human is present.
  if (event === "prompt") return void (!String(input.prompt || "").startsWith("[ccim]") && (await api(s, "POST", "human", {}, 2000)));
  if (event === "start" && !alive(s.listenerPid)) return startCodexListener();
  if (event !== "stop") return;

  const who = await api(s, "GET", "who", null, 4000);
  if (who.status === 401) return void fs.rmSync(sessionFile(), { force: true });
  if (who.status !== 200) return;
  if (!alive(s.listenerPid)) startCodexListener();
  if (!who.members.find((m) => m.handle === s.handle)?.focus) return;
  const { messages = [] } = await api(s, "GET", "inbox?all=1", null, 4000);
  if (messages.length) await deliverToCodex(s, messages);
}

function startCodexListener() {
  const child = spawn(process.execPath, [__filename, "listen", "--foreground"], {
    detached: true,
    stdio: "ignore",
    env: { ...process.env, CCIM_SESSION: sessionId },
  });
  child.unref();
}

// Acks only after Codex accepted the message, so nothing is lost if the thread is gone.
async function deliverToCodex(s, messages) {
  const r = spawnSync(process.env.CCIM_CODEX || "codex", ["queue", "--thread", sessionId, "--message", format(s, messages)], { encoding: "utf8", timeout: 30000 });
  if (r.status !== 0 || /^Error:/m.test(r.stderr || "")) {
    fs.appendFileSync(path.join(HOME, "codex-queue.log"), `${new Date().toISOString()} ${sessionId} ${(r.stderr || r.error?.message || "").trim()}\n`);
    return false;
  }
  await api(s, "POST", "ack", { ids: messages.map((m) => m.id) }).catch(() => {});
  return true;
}

// One WebSocket connection. Resolves with the batch of messages, a reason to stop for good, or nothing (reconnect).
function listenOnce(s) {
  return new Promise((resolve) => {
    const ws = new WebSocket(`${s.relay.replace(/^http/, "ws")}/c/${s.channel}/listen`, ["ccim", s.token]);
    const batch = new Map();
    let wasOpen = false;
    let ping;
    ws.onopen = () => { wasOpen = true; ping = setInterval(() => ws.send("ping"), 30000); };
    ws.onmessage = ({ data }) => {
      if (data === "pong") return;
      const msg = JSON.parse(data);
      if (msg.type !== "msg") return;
      // The caller acks once the batch is safely handed over.
      if (!batch.size) setTimeout(() => ws.close(1000), BATCH_MS);
      batch.set(msg.id, msg);
    };
    ws.onerror = () => {};
    ws.onclose = ({ code }) => {
      clearInterval(ping);
      if (batch.size) return resolve({ messages: [...batch.values()] });
      if (code === 4001) return resolve({ lost: true, stop: `"${s.handle}" was taken over by another session or left the channel. Do not re-arm the listener unless your user asks to join again.` });
      if (code === 4002) return resolve({ stop: "a newer listener for this session replaced this one. Nothing to do." });
      if (code === 4003) return resolve({ lost: true, stop: `channel "${s.channel}" was deleted. Do not re-arm the listener.` });
      resolve({ wasOpen });
    };
  });
}

// Like listenOnce, but stays connected: each burst of messages is handed to onBatch, which returns false when the
// session can no longer be reached. Resolves when the connection ends, with the same outcomes as listenOnce.
function watch(s, onBatch) {
  return new Promise((resolve) => {
    const ws = new WebSocket(`${s.relay.replace(/^http/, "ws")}/c/${s.channel}/listen`, ["ccim", s.token]);
    let batch = new Map();
    let flush;
    let wasOpen = false;
    let unreachable = false;
    let ping;
    ws.onopen = () => { wasOpen = true; ping = setInterval(() => ws.send("ping"), 30000); };
    ws.onmessage = ({ data }) => {
      if (data === "pong") return;
      const msg = JSON.parse(data);
      if (msg.type !== "msg") return;
      batch.set(msg.id, msg);
      flush ||= setTimeout(async () => {
        const messages = [...batch.values()];
        batch = new Map();
        flush = undefined;
        if (!(await onBatch(messages))) {
          unreachable = true;
          ws.close(1000);
        }
      }, BATCH_MS);
    };
    ws.onerror = () => {};
    ws.onclose = ({ code }) => {
      clearInterval(ping);
      clearTimeout(flush);
      if (unreachable) return resolve({ unreachable: true });
      if (code === 4001) return resolve({ lost: true, stop: true });
      if (code === 4002) return resolve({ stop: true });
      if (code === 4003) return resolve({ lost: true, stop: true });
      resolve({ wasOpen });
    };
  });
}

// True while a process is accepting connections on the socket. Connecting and closing at once delivers nothing.
function socketAlive(socket) {
  return new Promise((resolve) => {
    const c = require("net").createConnection(socket.replace(/^uds:/, ""));
    const done = (ok) => { clearTimeout(timer); c.destroy(); resolve(ok); };
    const timer = setTimeout(() => done(false), 3000);
    c.on("connect", () => done(true));
    c.on("error", () => done(false));
  });
}

const [cmd, ...args] = process.argv.slice(2);
if (!commands[cmd]) {
  console.log("usage: ccim <join|send|inbox|listen|who|focus|leave|delete|status>\n  join <channel>/<handle> [--secret-file path] [--relay url]\n  send <handle|*> [--urgent] \"<text>\"\n  inbox             print the messages waiting for this session and mark them read\n  listen            make sure this session receives messages (outside Claude Code and Codex: wait, print, exit)\n  who | focus on|off | leave | status\n  delete <channel> [--secret-file path]   delete the whole channel for everyone");
  process.exit(cmd ? 1 : 0);
}
if ((cmd === "join" || cmd === "delete") && args.includes("--secret")) {
  console.error("[ccim] --secret is deprecated: arguments may be visible in shell history and process listings. Use --secret-file <private-file> instead. Credential value omitted.");
}
Promise.resolve(commands[cmd](args)).then(
  () => process.exit(0),
  (err) => (cmd === "hook" ? process.exit(0) : die(err.message)),
);
